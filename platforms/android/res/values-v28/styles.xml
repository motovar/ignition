<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Landscape, the camera's cutout is on a short edge: without this the
         window stops short of it and leaves a black band down that side. -->
    <style name="IgnitionTheme" parent="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
